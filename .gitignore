# ========================================================
# Visual Studio - Fisiere interne si cache (ESENTIAL)
# ========================================================
.vs/
FileContentIndex/

# ========================================================
# Fisiere de configurare utilizator
# ========================================================
*.user
*.suo
*.userosscache
*.sln.docstates

# ========================================================
# Baze de date IntelliSense
# ========================================================
*.db
*.opendb
*.VC.opendb

# ========================================================
# Directoare de build generate de compilator
# ========================================================
x64/
x86/
[Dd]ebug/
[Rr]elease/

# Foldere intermediare generate in interiorul proiectului
Biliard/x64/
Biliard/Debug/
Biliard/Release/

# Fisiere binare intermediare si temporare de build
*.obj
*.ilk
*.pdb
*.tlog
*.idb
*.lastbuildstate
*.log
*.tmp

# Executabile de iesire
*.exe

# Fisiere arhiva
*.zip

# Visual Studio temporary folders
enc_temp_folder/

# ========================================================
# Pastram bibliotecile externe necesare proiectului (lib/)
# ========================================================
!lib/**/*.lib
!lib/**/*.dll
